#!/bin/bash
# pre-commit hook

# COLORS
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# AssetRegistry/ json validation
ERRORS=0
WARNINGS=0
CHECKED=0

REQUIRED_FIELDS=("name" "version" "date" "author" "description" "file" "download_url" "sha256" "ue_version" "install_path" "contents" "changelog")

# only staged json files in AssetRegistry/
STAGED_FILES=$(git diff --cached --name-only | grep "^AssetRegistry/.*\.json$")

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

echo -e "\n${BOLD}asset-registry${NC} validating staged pack definitions...\n"

for file in $STAGED_FILES; do

    echo -e "  ${CYAN}check${NC}   $file"

    # 1 check json syntax
    if ! python -m json.tool "$file" > /dev/null 2>&1; then
        echo -e "  ${RED}error${NC}   $file: invalid JSON syntax"
        ERRORS=$((ERRORS + 1))
        continue
    fi

    # py helper to read field value
    get_field() {
        python -c "
import json, sys
try:
    d = json.load(open('$1'))
    v = d.get('$2', None)
    if v is None:
        print('')
    elif isinstance(v, list):
        print('__list__' if len(v) > 0 else '')
    else:
        print(str(v).strip())
except:
    print('')
" 2>/dev/null
    }

    # 2 checking required fields
    for field in "${REQUIRED_FIELDS[@]}"; do
        VALUE=$(get_field "$file" "$field")
        if [ -z "$VALUE" ]; then
            echo -e "  ${RED}error${NC}   $file: missing required field '$field'"
            ERRORS=$((ERRORS + 1))
        fi
    done

    # 3 checking for placeholder fields
    SHA=$(get_field "$file" "sha256")
    if [[ "$SHA" == "<"* ]] || [ -z "$SHA" ]; then
        echo -e "  ${RED}error${NC}   $file: field 'sha256' is still a placeholder — run: sha256sum <file.zip>"
        ERRORS=$((ERRORS + 1))
    fi

    URL=$(get_field "$file" "download_url")
    if [[ "$URL" == *"<"* ]] || [ -z "$URL" ]; then
        echo -e "  ${RED}error${NC}   $file: field 'download_url' is still a placeholder"
        ERRORS=$((ERRORS + 1))
    fi

    # 4 checking semver
    VERSION=$(get_field "$file" "version")
    if ! echo "$VERSION" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$'; then
        echo -e "  ${YELLOW}warn${NC}    $file: field 'version' is not semver — expected X.Y.Z, got '$VERSION'"
        WARNINGS=$((WARNINGS + 1))
    fi

    # 5 checking ISO 8601 date format
    DATE=$(get_field "$file" "date")
    if ! echo "$DATE" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'; then
        echo -e "  ${YELLOW}warn${NC}    $file: field 'date' is not ISO 8601 — expected YYYY-MM-DD, got '$DATE'"
        WARNINGS=$((WARNINGS + 1))
    fi

    # 6 chaecking proper name and file name
    FILE_FIELD=$(get_field "$file" "file")
    if ! echo "$FILE_FIELD" | grep -qE '\.zip$'; then
        echo -e "  ${YELLOW}warn${NC}    $file: field 'file' does not end with .zip"
        WARNINGS=$((WARNINGS + 1))
    fi

    # 7 checking if json name matches file name
    BASENAME=$(basename "$file" .json)
    FILE_NO_EXT="${FILE_FIELD%.zip}"
    if [ "$BASENAME" != "$FILE_NO_EXT" ]; then
        echo -e "  ${YELLOW}warn${NC}    $file: filename '${BASENAME}.json' does not match 'file' field '${FILE_FIELD}'"
        WARNINGS=$((WARNINGS + 1))
    fi

    CHECKED=$((CHECKED + 1))
    echo -e "  ${GREEN}ok${NC}      $file"

done

# summary
echo ""

if [ $ERRORS -gt 0 ] && [ $WARNINGS -gt 0 ]; then
    echo -e "asset-registry ${RED}$ERRORS error(s)${NC}, ${YELLOW}$WARNINGS warning(s)${NC} — commit aborted"
    echo ""
    exit 1
elif [ $ERRORS -gt 0 ]; then
    echo -e "asset-registry ${RED}$ERRORS error(s)${NC} — commit aborted"
    echo ""
    exit 1
elif [ $WARNINGS -gt 0 ]; then
    echo -e "asset-registry ${GREEN}$CHECKED pack(s) ok${NC}, ${YELLOW}$WARNINGS warning(s)${NC}"
    echo ""
    exit 0
else
    echo -e "asset-registry ${GREEN}$CHECKED pack(s) ok${NC}"
    echo ""
    exit 0
fi
